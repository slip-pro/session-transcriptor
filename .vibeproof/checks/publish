#!/bin/sh
# Branch-route publishing helper (BD-42). The project's own procedure always comes first.
# Usage:
#   publish diff [<ref>]    closed changes and commits in <ref> (default HEAD) not yet on the main branch
#   publish go <commit>     fast-forward the main branch to <commit>, which must contain origin/<main>
#   publish back <commit>   put the code of an earlier main-branch <commit> back with a new restore commit
# The main branch is "Live branch:" in product/operations.md. Never force-pushes. Waiting for the
# host and looking at the result where the main branch deploys is the agent's job.

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo 'VIBEPROOF REFUSED VP-CANT-CHECK: not inside a git repository' >&2; exit 3; }
cd "$root" || exit 3
. "$root/.vibeproof/checks/lib.sh"
stop() { vp_refuse VP-PUBLISH "$1"; exit 1; }

live=$(vp_live_branch) || exit 3
branch=$(git symbolic-ref --quiet --short HEAD) || branch=
vp_fetch "$branch" || stop 'cannot reach the remote; nothing was published'
live_tip=$(git rev-parse -q --verify "refs/remotes/origin/$live") || live_tip=

case "$1" in
diff)
  ref=${2:-HEAD}
  target=$(git rev-parse -q --verify "$ref^{commit}") || stop "name a commit or branch to compare, not $ref"
  open=$(for id in $(vp_open_changes); do
    [ "$(vp_status < "product/changes/$id/brief.md" 2>/dev/null)" != agreed ] || echo "$id"
  done)
  [ -z "$open" ] || echo "agreed changes still open (they can't go out): $(printf '%s' "$open" | tr '\n' ' ')"
  if [ "$ref" = HEAD ] && [ -n "$branch" ] && mine=$(git rev-parse -q --verify "refs/remotes/origin/$branch") &&
    [ "$target" != "$mine" ]; then
    echo "this checkout differs from origin/$branch; push or pull first"
  fi
  if [ -n "$live_tip" ]; then
    git merge-base --is-ancestor "$live_tip" "$target" ||
      stop "origin/$live has commits that $ref doesn't; merge origin/$live into it, re-check, then compare again"
    range="$live_tip..$target"
  else
    range=$target
  fi
  echo "$live: ${live_tip:-none}   $ref: $target"
  echo "closed changes not yet on $live:"
  git log --format='%s' "$range" | awk '/^close C-[0-9]+$/ { print "  " $2; n++ } END { if (!n) print "  none" }'
  echo "commits not yet on $live:"
  git log --format='  %h %s' "$range"
  # Accepted elsewhere but left out: other local branches and the remote branches this clone knows.
  git fetch -q origin 2>/dev/null
  echo "closed changes on other branches, not in $ref:"
  git log --format='%s' --branches --remotes=origin --not "$target" |
    awk '/^close C-[0-9]+$/ && !seen[$2]++ { print "  " $2; n++ } END { if (!n) print "  none" }'
  ;;
go)
  target=$(git rev-parse -q --verify "$2^{commit}") || stop 'name the exact commit to publish'
  # Drafts carry no code, so only an agreed change that is still open blocks publishing.
  for d in $(git ls-tree -d --name-only "$target" product/changes/ | grep -v '^product/changes/closed$'); do
    [ "$(git show "$target:$d/brief.md" 2>/dev/null | vp_status)" != agreed ] ||
      stop "that commit has an agreed change still open (${d#product/changes/}); only closed changes go out"
  done
  if [ -n "$live_tip" ]; then
    git merge-base --is-ancestor "$live_tip" "$target" ||
      stop "origin/$live has commits that commit doesn't, so it is not a fast-forward. Merge origin/$live into its branch, re-check, then publish the merged commit"
  fi
  base=${live_tip:-$(git rev-list --max-parents=0 "$target" | tail -n 1)}
  paths=$(vp_git diff --name-only --no-renames "$base" "$target") || vp_cant_check 'cannot list the release paths'
  case "$paths" in \"*|*"
\""*) stop 'the release has file names git had to quote; check it by hand' ;; esac
  migrations=$(printf '%s\n' "$paths" | grep -E '(^|/)(migrations?|supabase/migrations)/|\.sql$|(^|/)schema\.prisma$')
  [ -z "$migrations" ] || stop "the release changes the database ($(printf '%s' "$migrations" | tr '\n' ' ')); follow the project's own procedure for it, this helper doesn't apply migrations"
  if [ -f .github/workflows/vibeproof.yml ]; then
    # Verdicts are kept per branch (results/<branch>.txt); any branch that reported this commit counts.
    git fetch -q origin vibeproof-check 2>/dev/null || stop "the GitHub check hasn't reported yet; wait and try again"
    full=$(git rev-parse "$target")
    seen=0
    for f in $(git ls-tree --name-only FETCH_HEAD results/ 2>/dev/null); do
      result=$(git show "FETCH_HEAD:$f" 2>/dev/null | sed '/^$/,$d')
      [ "$(printf '%s\n' "$result" | awk '$1 == "commit:" && NF == 2 { print $2 }')" = "$full" ] || continue
      seen=1
      [ "$(printf '%s\n' "$result" | awk '$1 == "verdict:" && NF == 2 { print $2 }')" = pass ] ||
        stop "the GitHub check did not pass this commit; fix that first"
    done
    [ "$seen" -eq 1 ] || stop "the GitHub check hasn't reported on this exact commit; wait and try again"
  fi
  git push -q origin "$target:refs/heads/$live" || stop "the push to $live was refused; nothing was published"
  echo "pushed $(git rev-parse --short "$target") to $live; now open the site $live deploys to and check it"
  ;;
back)
  [ -n "$live_tip" ] || stop "origin/$live does not exist; there is nothing to restore"
  target=$(git rev-parse -q --verify "$2^{commit}") || stop "name the earlier $live commit to put back"
  git merge-base --is-ancestor "$target" "$live_tip" || stop "that commit was never on $live"
  restore=$(git commit-tree "$target^{tree}" -p "$live_tip" -m "restore: $(git rev-parse "$target") put back on $live") ||
    vp_cant_check 'could not build the restore commit'
  git push -q origin "$restore:refs/heads/$live" || stop "the push to $live was refused; $live is unchanged"
  echo "restored the code of $(git rev-parse --short "$target") on $live as $(git rev-parse --short "$restore")."
  echo "Data is not restored. Bring the restore into your branch with: git pull --no-rebase origin $live"
  ;;
*) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
