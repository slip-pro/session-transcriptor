#!/bin/sh
# Pinned, deliberately narrow rules. Never print matched content.
# index: staged snapshot, history: every reachable commit (including deleted files).
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'VIBEPROOF REFUSED VP-CANT-CHECK: not inside a git repository\n' >&2
  exit 3
}
cd "$root" || exit 3
. "$root/.vibeproof/checks/lib.sh"
mode=${1:-index}
case "$mode" in index|history|bundle) ;; *) vp_cant_check "usage: secrets [index|history|bundle]" ;; esac
tmp=$(mktemp -d) || vp_cant_check "cannot create secret-scan scratch space"
trap 'rm -rf "$tmp"' EXIT
set -f
found=0
# Known fake test content is excused by a "secret-ok: <path> <blob> — <reason>" line in product/settings.md,
# bound to that exact content:
# staged settings for a commit, the current tree for history and build output (BD-42).
case "$mode" in
  index) allowed=$(git show :product/settings.md 2>/dev/null | vp_setting_paths secret-ok) ;;
  history) allowed=$(git show HEAD:product/settings.md 2>/dev/null | vp_setting_paths secret-ok) ;;
  *) allowed=$(vp_setting_paths secret-ok < product/settings.md 2>/dev/null) ;;
esac
report_secret() {
  blob=$(git hash-object --no-filters -- "$tmp/blob") || vp_cant_check 'cannot fingerprint scanned content'
  if printf '%s\n' "$allowed" | grep -Fqx -- "$path $blob"; then
    printf 'Secret scan: agreed exception applies to %s (%s).\n' "$path" "$context"
    return
  fi
  vp_refuse VP-SECRET "$1. Only for known fake test content, with the person's agreement: add 'secret-ok: $path $blob — <reason>' to product/settings.md; it covers exactly this content"
  found=1
}
scan_file() {
  path=$1
  case "${path##*/}" in
    .env|.env.*)
      case "${path##*/}" in .env.example|.env.sample|.env.template) ;;
        *) report_secret "$context: $path is an environment file; keep credentials in the secret store, not git" ;;
      esac ;;
  esac
  # v2: PEM private keys, classic/fine-grained GitHub tokens and Stripe secret/restricted keys.
  # No entropy heuristic, generic password matcher or claim that all secrets are covered.
  if vp_secret_content "$tmp/blob"; then
    report_secret "$context: $path contains a private-key header, GitHub token or Stripe secret/restricted key format (rules v2); remove it and replace any key that already left this machine"
  else
    rc=$?
    [ "$rc" -eq 1 ] || vp_cant_check "could not scan $path"
  fi
}
if [ "$mode" = index ]; then
  context=staged
  vp_git diff --cached --name-only --no-renames --diff-filter=ACMT > "$tmp/paths" || vp_cant_check "cannot list staged files"
  while IFS= read -r path; do
    vp_check_paths "$path"
    git show ":$path" > "$tmp/blob" || vp_cant_check "cannot read staged $path"
    scan_file "$path"
  done < "$tmp/paths"
elif [ "$mode" = bundle ]; then
  output=$(vp_line_value browser-output product/settings.md)
  case "$output" in ''|.|/*|-*|*..*|*\\*|.git|.git/*)
    vp_cant_check 'browser-output must name a repository-relative build directory' ;;
  esac
  prefix=''
  old_ifs=$IFS; IFS=/
  for part in $output; do
    prefix=${prefix:+$prefix/}$part
    [ ! -L "$prefix" ] || vp_cant_check 'browser output path contains a symbolic link'
  done
  IFS=$old_ifs
  [ -d "$output" ] || vp_cant_check 'browser output is missing; build the candidate first'
  find "$output" -type l > "$tmp/links" || vp_cant_check 'cannot inspect browser output links'
  [ ! -s "$tmp/links" ] || vp_cant_check 'browser output contains symbolic links; coverage is unavailable'
  find "$output" -type f > "$tmp/unsorted" || vp_cant_check 'cannot enumerate browser output'
  LC_ALL=C sort "$tmp/unsorted" > "$tmp/paths" || vp_cant_check 'cannot order browser output'
  [ -s "$tmp/paths" ] || vp_cant_check 'browser output is empty'
  : > "$tmp/manifest"
  context='browser output'
  while IFS= read -r path; do
    vp_check_paths "$path"
    [ -f "$path" ] && [ ! -L "$path" ] || vp_cant_check 'browser output changed while scanning'
    case "$path" in
      *.gz)
        command -v gzip >/dev/null 2>&1 || vp_cant_check 'gzip browser output cannot be decoded on this machine'
        gzip -cd -- "$path" > "$tmp/blob" 2>/dev/null || vp_cant_check 'cannot decode gzip browser output' ;;
      *.br|*.zip) vp_cant_check 'compressed browser output requires a supported decoder; coverage is unavailable' ;;
      *) cat "$path" > "$tmp/blob" || vp_cant_check 'cannot read browser output file' ;;
    esac
    scan_file "$path"
    printf '%s %s\n' "$(git hash-object --no-filters "$tmp/blob")" "$path" >> "$tmp/manifest"
  done < "$tmp/paths"
  printf 'Browser output digest: %s\n' "$(git hash-object --no-filters "$tmp/manifest")"
else
  # Shallow history cannot prove a whole-history scan.
  [ "$(git rev-parse --is-shallow-repository)" = false ] || vp_cant_check "history is shallow; fetch the full history before scanning"
  git rev-list --all > "$tmp/commits" || vp_cant_check "cannot enumerate history"
  : > "$tmp/seen"
  while IFS= read -r rev; do
    context="history $rev"
    vp_git ls-tree -r "$rev" > "$tmp/tree" || vp_cant_check "cannot read $rev"
    while IFS="$(printf '\t')" read -r meta path; do
      vp_check_paths "$path"
      set -- $meta
      [ "$2" = blob ] || continue
      identity="$3 $path"
      grep -Fqx -- "$identity" "$tmp/seen" && continue
      git cat-file blob "$3" > "$tmp/blob" || vp_cant_check "cannot read history blob"
      scan_file "$path"
      printf '%s\n' "$identity" >> "$tmp/seen"
    done < "$tmp/tree"
  done < "$tmp/commits"
fi
[ "$found" -eq 0 ] || exit 1
printf 'Secret scan (%s, rules v2) passed: environment files, private-key headers, classic/fine-grained GitHub tokens and Stripe secret/restricted key formats only; other secrets were not checked.\n' "$mode"
